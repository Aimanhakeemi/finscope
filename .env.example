# Copy to .env and fill in. All LLM-dependent features degrade gracefully if unset.

# Optional — enables the categorizer LLM fallback and the natural-language "Ask" box.
ANTHROPIC_API_KEY=

# Model used for LLM features.
FINSCOPE_LLM_MODEL=claude-sonnet-5

# Password used by the read-only PostgreSQL role for the future Ask feature.
FINSCOPE_READONLY_PASSWORD=change-me

# Set automatically by docker-compose; override for local (non-Docker) runs.
DATABASE_URL=postgresql+psycopg://finscope:finscope@localhost:5432/finscope
